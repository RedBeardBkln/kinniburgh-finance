# Copy to .env.local and fill in values. Never commit .env.local to git.

# PostgreSQL — Neon or Supabase connection string
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Supabase Storage (for receipt files) — Project Settings → API
SUPABASE_URL=""           # https://xxx.supabase.co
SUPABASE_SERVICE_KEY=""   # service_role key (not anon key)

# Claude API (receipt extraction)
ANTHROPIC_API_KEY=""



# "Assign to Eva" review queue: the link is EMAILED to the assignee's account email by
# default (via Resend). Carrier email-to-SMS gateways drop messages that contain links, so
# the SMS path is opt-in: set REVIEW_DELIVERY=sms and EVA_SMS_GATEWAY_ADDRESS.
REVIEW_DELIVERY=""
# Only used when REVIEW_DELIVERY=sms: Eva's carrier email-to-SMS gateway address.
EVA_SMS_GATEWAY_ADDRESS=""
# Resend "from" address. Must be on a domain verified in Resend, or Resend's sandbox
# sender can only deliver to the account owner.
EMAIL_FROM=""
# Sender for EK Consulting invoice e-mails only (an address on the Resend-verified domain), e.g. "LaunchTime Solutions <invoices@launchtime.solutions>". Never falls back to EMAIL_FROM.
INVOICE_EMAIL_FROM=""
# Public origin of the deployed app (no trailing slash). Used to build the link in messages.
# A localhost value in production is rejected (no message is sent).
NEXTAUTH_URL=""
# Bearer secret Vercel cron sends to /api/cron/* (incl. /api/cron/review-reminders)
CRON_SECRET=""
# EK Consulting online payments (Stripe Checkout pay link; owner toggle "Online payments", default off). Values live only in
# Vercel / your local .env: NEVER commit them. Use a RESTRICTED key (Checkout Sessions write + read, PaymentIntents read,
# Charges read, Balance transactions read) of the same mode as STRIPE_MODE.
STRIPE_SECRET_KEY=""
# The signing secret of the Dashboard webhook endpoint /api/stripe/webhook (snapshot events).
STRIPE_WEBHOOK_SECRET=""
# "test" or "live"; must match the key's mode. Events whose livemode disagrees are ignored.
STRIPE_MODE="test"
# Optional: a separate public origin for EK Consulting client invoice links (/i/<token>) and Checkout's return pages, e.g. a pay
# domain added to the Vercel project. An https origin only (no path, query or trailing segments; localhost only in test mode).
# Unset = links use NEXTAUTH_URL. An INVALID value is NOT ignored: no link is made until it is fixed. When valid, that host serves
# only the /i pages (everything else there is a 404).
INVOICE_PUBLIC_BASE_URL=""
