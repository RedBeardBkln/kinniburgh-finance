// Money is stored as NUMERIC(14,2) — never floats.
// All dates stored UTC. Soft-delete via archivedAt on tax-relevant records.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(uuid())
  name                String
  email               String    @unique
  passwordHash        String
  role                String    @default("owner")
  totpSecret          String?   // encrypted; null = MFA not yet enrolled
  totpVerified        Boolean   @default(false)
  notificationPrefs   Json      @default("{}")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions              Session[]
  notificationUsers     NotificationUser[]
  pushSubscriptions     PushSubscription[]
  auditLogs             AuditLog[]
  vaultOtps             VaultOtp[]
  vaultSessions         VaultSession[]
  passwordResetTokens   PasswordResetToken[]
  approvedNotifications Notification[]        @relation("NotificationApprovedBy")
  reviewBatchesAssigned ReviewBatch[]         @relation("ReviewBatchAssignee")
  reviewBatchesCreated  ReviewBatch[]         @relation("ReviewBatchCreator")
  documentsAsSubject    Document[]            @relation("DocumentSubject")
  documentsConfirmed    Document[]            @relation("DocumentExtractionConfirmer")
  donationsCreated      Donation[]            @relation("DonationCreator")
  fixedAssetsCreated    FixedAsset[]          @relation("FixedAssetCreator")
  taxQuestionnaireNotes TaxQuestionnaire[]    @relation("TaxQuestionnaireNoteAuthor")
  taxReturnOverridesSet      TaxReturnOverride[] @relation("TaxReturnOverrideSetter")
  taxReturnOverridesArchived TaxReturnOverride[] @relation("TaxReturnOverrideArchiver")
  taxFactsSet                TaxFact[]           @relation("TaxFactSetter")
  taxFactsArchived           TaxFact[]           @relation("TaxFactArchiver")
  taxReviewRunsStarted       TaxReviewRun[]      @relation("TaxReviewRunStarter")
  taxReviewDispositions      TaxReviewFindingDisposition[] @relation("TaxReviewDispositionAuthor")
  taxReturnApprovalsGiven    TaxReturnApproval[] @relation("TaxReturnApprovalApprover")
}

model PasswordResetToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Core financial entities ─────────────────────────────────────────────────

model Entity {
  id             String    @id @default(uuid())
  name           String    @unique
  slug           String?   @unique  // URL-safe slug; null = not shown in nav
  navLabel       String?            // short label for header tabs
  hiddenInNav    Boolean   @default(false)
  dbaName        String?
  type           String    // personal | business
  foundedDate    DateTime?
  taxStatusNotes String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts          Account[]
  transactions      Transaction[]
  budgets           Budget[]
  receipts          Receipt[]
  glCodes           GlCode[]
  documents         Document[]
  scheduledBills    ScheduledBill[]
  notifications     Notification[]
  incomeSources     IncomeSource[]
  taxWorkspaces     TaxWorkspace[]
  insurancePolicies  InsurancePolicy[]
  mileageEntries     MileageEntry[]
  taxDeadlines       TaxDeadline[]
  projects           Project[]
  recurringExpenses  RecurringExpense[]
  rentalBookings     RentalBooking[]
  paystubs           Paystub[]
  projectedRevenues  ProjectedRevenue[]
  bankStatements     BankStatement[]
  tagGlCodeMappings  TagGlCodeMapping[]
  donations          Donation[]
  fixedAssets        FixedAsset[]
  taxQuestionnaires  TaxQuestionnaire[]
  taxReturnOverrides TaxReturnOverride[]
  taxFacts           TaxFact[]
  taxReviewRuns      TaxReviewRun[]
  taxReviewDispositions TaxReviewFindingDisposition[]
  taxReturnApprovals TaxReturnApproval[]
}

model Institution {
  id                  String    @id @default(uuid())
  name                String    @unique
  plaidInstitutionId  String?   // Plaid's institution_id, populated on first connect attempt
  plaidCoverageNotes  String?   // supported | unsupported | requires_fallback
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  accounts  Account[]
}

model Account {
  id                 String      @id @default(uuid())
  institutionId      String
  entityId           String
  nickname           String
  mask               String?     // last 4 digits
  accountType        String      // checking | savings | credit_card | mortgage | loan | investment | insurance
  minimumBalance     Decimal?    @db.Decimal(14, 2)
  minimumBalanceFee  Decimal?    @db.Decimal(14, 2)
  integrationMode    String      @default("manual_entry") // plaid | manual_import | manual_entry
  currency           String      @default("USD")
  plaidItemId        String?   // references PlaidItem.itemId
  plaidAccountId     String?   // Plaid's per-account account_id
  currentBalance     Decimal?  @db.Decimal(14, 2) // manually set or Plaid-synced
  currentBalanceAt   DateTime?                       // when currentBalance was last set
  // Credit card statement data — synced from Plaid Liabilities (spec 04).
  // statementBalance = pay this by dueDate to avoid interest charges.
  ccDueDate          DateTime?
  ccStatementBalance Decimal?  @db.Decimal(14, 2)
  ccMinimumPayment   Decimal?  @db.Decimal(14, 2)
  ccApr              Decimal?  @db.Decimal(6, 3)   // e.g. 24.990
  ccDataAt           DateTime?                       // when statement data was last synced
  archivedAt         DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  institution              Institution        @relation(fields: [institutionId], references: [id])
  entity                   Entity             @relation(fields: [entityId], references: [id])
  plaidItem                PlaidItem?         @relation(fields: [plaidItemId], references: [itemId])
  transactions             Transaction[]
  budgets                  Budget[]
  scheduledTransfersFrom   ScheduledTransfer[] @relation("FromAccount")
  scheduledTransfersTo     ScheduledTransfer[] @relation("ToAccount")
  scheduledBills       ScheduledBill[]
  accrualEnvelopes     AccrualEnvelope[]
  tagRules             TagRule[]
  incomeSources        IncomeSource[]
  projects             Project[]
  receipts             Receipt[]
  debtDetail           DebtDetail?
  projectedRevenues    ProjectedRevenue[]
  paystubDeposits      Paystub[]     @relation("PaystubDepositAccount")
  bankStatements       BankStatement[]

  @@unique([entityId, nickname])
}

// ─── Transactions ─────────────────────────────────────────────────────────────

model Transaction {
  id                 String    @id @default(uuid())
  accountId          String
  entityId           String
  postedAt           DateTime
  amount             Decimal   @db.Decimal(14, 2) // negative = outflow
  payeeRaw           String?
  payeeNormalized    String?
  description        String?
  notes              String?   // user-entered note about this transaction
  source             String    // plaid | import | manual | receipt
  plaidTransactionId String?   @unique
  pending            Boolean   @default(false)
  transferPairId     String?   // links the two legs of an internal transfer
  scheduledTransferId String?  // which ScheduledTransfer this transfer pair fulfills, if any
  receiptId          String?
  glCodeId           String?
  projectId          String?   // optional assignment to a Project
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  account           Account            @relation(fields: [accountId], references: [id])
  entity            Entity             @relation(fields: [entityId], references: [id])
  tags              TransactionTag[]
  receipt           Receipt?           @relation(fields: [receiptId], references: [id])
  glCode            GlCode?            @relation(fields: [glCodeId], references: [id])
  project           Project?           @relation(fields: [projectId], references: [id])
  scheduledTransfer ScheduledTransfer? @relation(fields: [scheduledTransferId], references: [id])
  auditLogs         AuditLog[]
  reviewAssignments TransactionAssignment[]
}

// ─── Tags ─────────────────────────────────────────────────────────────────────

model Tag {
  id        String    @id @default(uuid())
  name      String    @unique // full path: "Food & Drink / Groceries"
  shortName String    // leaf segment only
  parentId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  parent             Tag?              @relation("TagHierarchy", fields: [parentId], references: [id])
  children           Tag[]             @relation("TagHierarchy")
  transactions       TransactionTag[]
  budgets            Budget[]
  tagRules           TagRule[]
  recurringExpenses  RecurringExpense[]
  debtDetails        DebtDetail[]
  glCodeMappings     TagGlCodeMapping[]
}

model TransactionTag {
  id            String      @id @default(uuid())
  transactionId String
  tagId         String
  createdAt     DateTime    @default(now())

  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag           Tag         @relation(fields: [tagId], references: [id])

  @@unique([transactionId, tagId])
}

// ─── Review queue ("Assign to Eva") ───────────────────────────────────────────
// Assignment state lives here, NOT on Transaction (transactions stay immutable
// facts). Statuses are plain Strings (repo convention), validated at the app
// layer in lib/review-queue.ts. Phase 1 uses ReviewBatch (draft) and
// TransactionAssignment; ReviewLinkToken and the sms*/reminder* columns are
// created now so the whole feature ships with a single migration.

model ReviewBatch {
  id              String    @id @default(uuid())
  assigneeUserId  String
  createdByUserId String
  status          String    @default("draft") // draft | submitted | completed | cancelled
  submittedAt     DateTime?
  firstOpenedAt   DateTime?
  completedAt     DateTime?
  expiresAt       DateTime?
  smsStatus       String?   // null | sent | failed  (initial text)
  smsSentAt       DateTime?
  smsError        String?   // sanitized; never the recipient address or token
  reminderStatus  String?   // null | sending | sent | failed
  reminderSentAt  DateTime?
  reminderError   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  assignee    User                    @relation("ReviewBatchAssignee", fields: [assigneeUserId], references: [id])
  createdBy   User                    @relation("ReviewBatchCreator", fields: [createdByUserId], references: [id])
  tokens      ReviewLinkToken[]
  assignments TransactionAssignment[]
}

model ReviewLinkToken {
  id         String    @id @default(uuid())
  batchId    String
  tokenHash  String    @unique // SHA-256 hex of the raw token; raw token is never stored
  kind       String    // initial | reminder | resend
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  batch ReviewBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

model TransactionAssignment {
  id            String    @id @default(uuid())
  transactionId String
  batchId       String
  status        String    @default("pending") // pending | resolved | returned | removed
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id])
  batch       ReviewBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([transactionId, batchId])
}

// ─── Budgets ──────────────────────────────────────────────────────────────────

model Budget {
  id              String   @id @default(uuid())
  tagId           String
  entityId        String
  accountId       String
  period          String   // YYYY-MM
  budgeted              Decimal? @db.Decimal(14, 2)  // null = auto-sum from nested children (budget-parent-auto-sum)
  additionalAmountCents Decimal  @default(0) @db.Decimal(14, 2)
  payDay                Int?     // day of month (1–31) when this bill is paid (frequency == "monthly" only)
  frequency             String   @default("monthly") // monthly | weekly | biweekly | annual — budgeted always stays a MONTHLY total regardless (for annual: the monthly set-aside)
  payDayOfWeek          Int?     // 0=Sun..6=Sat — used only when frequency is weekly | biweekly
  biweeklyAnchorDate    DateTime? // used only when frequency == "biweekly"; establishes the 14-day cycle
  payMonth              Int?     // month (1–12) the bill is due — used only when frequency == "annual" (day is payDay)
  annualAmountDue       Decimal? @db.Decimal(14, 2) // total due on the annual due date — used only when frequency == "annual"
  rolloverEnabled       Boolean  @default(false)
  rolloverAmount        Decimal? @db.Decimal(14, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tag     Tag     @relation(fields: [tagId], references: [id])
  entity  Entity  @relation(fields: [entityId], references: [id])
  account Account @relation(fields: [accountId], references: [id])

  @@unique([tagId, entityId, period])
}

// ─── Envelope automation ──────────────────────────────────────────────────────

model ScheduledTransfer {
  id            String   @id @default(uuid())
  fromAccountId String
  toAccountId   String
  amount        Decimal  @db.Decimal(14, 2)
  cadence       String   // weekly | semi_monthly | monthly
  dayRules      Json     // e.g. {"dayOfWeek": 1} or {"daysOfMonth": [1, 15]}
  purpose       String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  fromAccount  Account       @relation("FromAccount", fields: [fromAccountId], references: [id])
  toAccount    Account       @relation("ToAccount", fields: [toAccountId], references: [id])
  transactions Transaction[]
}

model ScheduledBill {
  id              String   @id @default(uuid())
  accountId       String
  entityId        String
  payee           String
  amountType      String   // static | fluctuating | accrued
  expectedAmount  Decimal? @db.Decimal(14, 2)
  autopayDay      Int?     // day of month (frequency == "monthly" only)
  frequency       String   @default("monthly") // monthly | weekly | biweekly | annual — expectedAmount always stays a MONTHLY total regardless (for annual: the monthly set-aside; annualBudget holds the total due)
  payDayOfWeek    Int?     // 0=Sun..6=Sat — used only when frequency is weekly | biweekly
  biweeklyAnchorDate DateTime? // used only when frequency == "biweekly"; establishes the 14-day cycle
  payMonth        Int?     // month (1–12) the bill is due — used only when frequency == "annual" (day is autopayDay)
  annualBudget    Decimal? @db.Decimal(14, 2)
  active          Boolean  @default(true)
  budgetTagId     String?  // Tag.id — set when auto-created from a budget line
  budgetEntityId  String?  // Entity.id — mirrors entityId for compound upsert key
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  account         Account          @relation(fields: [accountId], references: [id])
  entity          Entity           @relation(fields: [entityId], references: [id])
  accrualEnvelope AccrualEnvelope? // back-relation only, no column here

  @@unique([budgetTagId, budgetEntityId])
}

// ─── Recurring expenses (forecast + budget planning) ─────────────────────────

model RecurringExpense {
  id          String    @id @default(uuid())
  entityId    String
  name        String
  amountCents Int       // actual amount per occurrence
  frequency   String    // monthly | weekly | biweekly | quarterly | annually
  dueDay      Int?      // day of month (1–31) for monthly expenses
  nextDueDate DateTime? // next occurrence date (optional)
  tagId       String?   // linked budget category (Tag)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  entity Entity @relation(fields: [entityId], references: [id])
  tag    Tag?   @relation(fields: [tagId], references: [id])
}

// ─── Rental bookings (Airbnb CSV import for forecast) ────────────────────────

model RentalBooking {
  id               String   @id @default(uuid())
  entityId         String
  confirmationCode String
  payoutDate       DateTime
  startDate        DateTime
  endDate          DateTime
  nights           Int
  guest            String
  listing          String
  grossEarnings    Decimal  @db.Decimal(10, 2)
  currency         String   @default("USD")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, confirmationCode])
}

model AccrualEnvelope {
  id                 String   @id @default(uuid())
  accountId          String
  name               String
  targetAnnualAmount Decimal  @db.Decimal(14, 2)
  fundingTransferId  String?
  currentBalance     Decimal  @db.Decimal(14, 2) @default(0)
  expectedDrawMonths Json     // [10, 11, 12, 1, 2, 3] = Oct–Mar for oil
  scheduledBillId    String?  @unique // optional link to the ScheduledBill this envelope funds
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  account       Account        @relation(fields: [accountId], references: [id])
  scheduledBill ScheduledBill? @relation(fields: [scheduledBillId], references: [id])
  draws         AccrualDraw[]
}

model AccrualDraw {
  id                String   @id @default(uuid())
  accrualEnvelopeId String
  estimatedDate     DateTime
  estimatedAmount   Decimal  @db.Decimal(14, 2)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  accrualEnvelope AccrualEnvelope @relation(fields: [accrualEnvelopeId], references: [id], onDelete: Cascade)
}

// ─── Receipts ─────────────────────────────────────────────────────────────────

model Receipt {
  id            String    @id @default(uuid())
  uploadedBy    String    // user id
  fileKey       String    // object storage key (encrypted at rest)
  capturedAt    DateTime
  ocrStatus     String    @default("pending") // pending | complete | failed
  vendor        String?
  receiptDate   DateTime?
  total         Decimal?  @db.Decimal(14, 2)
  description   String?
  memo          String?   // user-entered note
  glCode        String?   // freeform GL account / bookkeeping category
  taxCategory   String?   // IRS expense category for tax purposes
  ocrRaw        Json?     // raw Claude extraction response
  confirmedAt   DateTime?
  confirmedById String?   // user id (plain string, same pattern as uploadedBy)
  entityId      String
  accountId     String?   // bank account this receipt came from
  projectId     String?   // optional assignment to a Project
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  entity       Entity        @relation(fields: [entityId], references: [id])
  account      Account?      @relation(fields: [accountId], references: [id])
  project      Project?      @relation(fields: [projectId], references: [id])
  transactions Transaction[]
}

// ─── GL codes (chart of accounts, imported from QB/CPA in Phase 5) ────────────

model GlCode {
  id         String    @id @default(uuid())
  entityId   String
  code       String
  name       String
  type       String    // asset | liability | equity | revenue | expense
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  entity       Entity        @relation(fields: [entityId], references: [id])
  transactions Transaction[]
  tagMappings  TagGlCodeMapping[]

  @@unique([entityId, code])
}

// ─── Tag → GL code mapping (per-entity auto-assignment config) ────────────────
// No DB-level constraint that glCodeId's entity matches entityId — Prisma can't
// express a composite FK against GlCode's own @@unique([entityId, code]).
// This MUST be enforced in application code (see actions/gl-code-mappings.ts
// upsertTagGlMapping) by checking glCode.entityId === entityId before writing,
// or it becomes possible to silently map a tag to another entity's GL code.

model TagGlCodeMapping {
  id        String   @id @default(uuid())
  entityId  String
  tagId     String
  glCodeId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity Entity @relation(fields: [entityId], references: [id])
  tag    Tag    @relation(fields: [tagId], references: [id])
  glCode GlCode @relation(fields: [glCodeId], references: [id])

  @@unique([entityId, tagId])
}

// ─── Bank statements (uploaded PDFs/images + extracted balances) ──────────────
// Source of truth for period balance sheets (monthly/quarterly/annual).
// Tax-relevant: archive only, never hard-delete. Amounts integer cents.

model BankStatement {
  id                String    @id @default(uuid())
  entityId          String
  documentId        String?   @unique // linked source Document in the vault
  accountId         String?   // null = entity-level statement (multi-account)
  periodStart       DateTime  // statement period start (UTC)
  periodEnd         DateTime  // statement period end (UTC)
  institutionName   String?
  accountMask       String?
  openingBalance    Decimal?  @db.Decimal(14, 2)
  closingBalance    Decimal?  @db.Decimal(14, 2)
  extractStatus     String    @default("pending") // pending | processing | complete | failed | skipped
  extractionData    Json?     // raw structured extraction (per-account rows if multi-account)
  extractModel      String?
  confirmedAt       DateTime?
  confirmedById     String?
  notes             String?
  uploadedBy         String    // user id
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  entity  Entity   @relation(fields: [entityId], references: [id])
  account Account? @relation(fields: [accountId], references: [id])
  document Document? @relation(fields: [documentId], references: [id])

  @@index([entityId, periodEnd])
}

// ─── Documents (tax vault + document intelligence) ───────────────────────────

// Tax-related records are NEVER hard-deleted; archivedAt only.
model Document {
  id                String    @id @default(uuid())
  entityId          String
  taxYear           Int?
  docType           String    // w2 | 1099 | k1 | extension | property_tax | mortgage_interest | donation_receipt | policy | statement | bank_statement | mortgage_statement | insurance_policy | utility_bill | other
  documentName      String?   // human-friendly name, autogenerated from parsed data, user-editable
  fileKey           String    // object storage key (encrypted)
  metadata          Json?
  notes             String?
  extractionStatus  String?   // pending | processing | complete | failed | skipped
  extractionData    Json?     // structured output from Claude extraction
  extractionModel   String?
  extractedAt       DateTime?
  archivedAt        DateTime? // archive only; hard delete is forbidden
  subjectType       String?   // person | joint; NULL = Unassigned (document-attribution)
  subjectUserId     String?   // the person (User) when subjectType = person
  issuerName        String?   // free-text issuer/payer (e.g. employer on a W-2); NULL = not set
  // Owner verification of the extracted values (document-extraction-status-and-review).
  // extractionStatus keeps meaning "the AI run finished"; "verified" is this separate fact.
  extractionConfirmedAt   DateTime? // NULL = not verified by the owner
  extractionConfirmedById String?   // who verified it
  extractionCorrections   Json?     // owner corrections overlay; never overwrites extractionData
  extractionError         String?   // short sanitized reason for the last failed run
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  entity          Entity           @relation(fields: [entityId], references: [id])
  subjectUser     User?            @relation("DocumentSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  extractionConfirmedBy User?      @relation("DocumentExtractionConfirmer", fields: [extractionConfirmedById], references: [id], onDelete: SetNull)
  insurancePolicy InsurancePolicy?
  solarEntries    SolarEntry[]
  bankStatement   BankStatement?
  donationReceipts   Donation[]   @relation("DonationReceipt")
  fixedAssetInvoices FixedAsset[] @relation("FixedAssetInvoice")
}

// ─── Insurance policies ───────────────────────────────────────────────────────

model InsurancePolicy {
  id                  String    @id @default(uuid())
  entityId            String
  documentId          String?   @unique // linked source Document (NWM policy upload)
  policyType          String    // term | whole | ul | property | auto | motorcycle | other
  insurer             String
  policyNumber        String?
  faceAmountCents     Int?      // cents — never float
  monthlyPremiumCents Int?      // cents ($755/mo for NWM = 75500)
  effectiveDate       DateTime?
  expiryDate          DateTime?
  notes               String?
  archivedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  entity           Entity            @relation(fields: [entityId], references: [id])
  document         Document?         @relation(fields: [documentId], references: [id])
  cashValueEntries PolicyCashValue[]
}

model PolicyCashValue {
  id             String          @id @default(uuid())
  policyId       String
  asOf           DateTime
  cashValueCents Int             // cents
  notes          String?
  createdAt      DateTime        @default(now())

  policy InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
}

// ─── Solar ROI tracker ────────────────────────────────────────────────────────

model SolarEntry {
  id              String   @id @default(uuid())
  period          String   // YYYY-MM
  billAmountCents Int      // cents
  usageKwh        Decimal? @db.Decimal(10, 2)
  gridCreditCents Int?     // cents
  documentId      String?  // linked utility_bill Document
  createdAt       DateTime @default(now())

  document Document? @relation(fields: [documentId], references: [id])
}

// ─── Monthly household review ─────────────────────────────────────────────────

model MonthlyReview {
  id        String   @id @default(uuid())
  period    String   @unique // YYYY-MM
  data      Json     // full summary: spend, budget health, upcoming, account snapshot
  createdAt DateTime @default(now())
}

// ─── Tax workspaces ───────────────────────────────────────────────────────────

// Tax-related records are NEVER hard-deleted.
model TaxWorkspace {
  id        String    @id @default(uuid())
  entityId  String
  taxYear   Int
  status    String    @default("in_progress") // in_progress | extended | filed
  deadline  DateTime?
  filedAt   DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  entity         Entity             @relation(fields: [entityId], references: [id])
  checklistItems TaxChecklistItem[]
  questions      TaxQuestion[]

  @@unique([entityId, taxYear])
}

model TaxChecklistItem {
  id          String    @id @default(uuid())
  workspaceId String
  label       String
  completed   Boolean   @default(false)
  completedAt DateTime?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace TaxWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ─── Tax planning questions (personal workspace) ─────────────────────────────
// Every question carries context + honest implications of each answer so the
// user can make critical decisions. Tax records are NEVER hard-deleted.

model TaxQuestion {
  id          String    @id @default(uuid())
  workspaceId String
  key         String    // stable key from the question bank, e.g. "home_office"
  category    String    // income | deductions | credits | filing_status | entity | other
  question    String    // full question text with context
  options     Json?     // [{ value, label, note }] — null = free-text answer
  answer      Json?     // user's answer (string or selected option value)
  answeredAt  DateTime?
  skippedReason String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace TaxWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
}

// ─── Projects (cross-entity expense tracker with master budget) ───────────────

model Project {
  id          String    @id @default(uuid())
  entityId    String?   // master entity (Personal, EK Consulting, etc.) — null = no entity assigned yet
  accountId   String?   // optional link to Slush Funds (x3612) account
  name        String
  description String?
  budget      Decimal   @db.Decimal(14, 2) // master budget; spend tracked from transactions + receipts
  targetDate  DateTime?
  status      String    @default("active") // active | completed | paused
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  entity       Entity?       @relation(fields: [entityId], references: [id])
  account      Account?      @relation(fields: [accountId], references: [id])
  transactions Transaction[]
  receipts     Receipt[]
}

// ─── Manual assets (property, vehicle — user-entered values only) ──────────────

model ManualAsset {
  id         String    @id @default(uuid())
  name       String    // "Sudden Valley property", "Toyota Tacoma 1999"
  category   String    // real_estate | vehicle | other
  valueCents Int       // cents — never float; user-entered or approved estimates only
  asOf       DateTime  // date of estimate
  notes      String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// ─── Net worth snapshots ───────────────────────────────────────────────────────

model NetWorthSnapshot {
  id                    String   @id @default(uuid())
  date                  DateTime @unique
  totalAssetsCents      Int
  totalLiabilitiesCents Int
  netWorthCents         Int
  data                  Json     // { accounts[], manualAssets[], cashValues[], liabilities[] }
  createdAt             DateTime @default(now())
}

// ─── Tag rules (payee → tag learning) ────────────────────────────────────────

model TagRule {
  id             String   @id @default(uuid())
  payeePattern   String?  // normalized payee matcher (exact or prefix)
  amountMin      Decimal? @db.Decimal(14, 2)
  amountMax      Decimal? @db.Decimal(14, 2)
  accountId      String?
  accountIds     String?  // JSON array of account IDs for multi-account matching
  tagId          String
  confidence     Float    @default(1.0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tag     Tag      @relation(fields: [tagId], references: [id])
  account Account? @relation(fields: [accountId], references: [id])
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(uuid())
  entityId  String?
  type      String    // overspend | low_balance | accrual_shortfall | bill_due | anomaly | ... | large_spend
  payload   Json
  sentAt    DateTime?
  channel   String    // push | email | in_app
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Shared approval flow (spec 05 §8 item 9). Applies only to "large_spend" and
  // "anomaly" types at the app layer (see lib/notification-types.ts) — no DB-level
  // type constraint. Stored on this shared row (not NotificationUser) so approval
  // is visible to every recipient, not a private per-user marker.
  approvedByUserId String?
  approvedAt       DateTime?

  entity     Entity?            @relation(fields: [entityId], references: [id])
  approvedBy User?              @relation("NotificationApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  users      NotificationUser[]
}

model NotificationUser {
  id             String       @id @default(uuid())
  notificationId String
  userId         String
  readAt         DateTime?

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@unique([notificationId, userId])
}

// ─── Push subscriptions (Web Push / VAPID) ───────────────────────────────────

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Audit log ────────────────────────────────────────────────────────────────

model AuditLog {
  id            String   @id @default(uuid())
  transactionId String?
  changedBy     String   // user id
  changeType    String   // entity_change | tag_change | category_change
  before        Json?
  after         Json?
  createdAt     DateTime @default(now())

  transaction Transaction? @relation(fields: [transactionId], references: [id])
  user        User         @relation(fields: [changedBy], references: [id])
}

// ─── Income sources (for cash-flow forecast) ─────────────────────────────────

model IncomeSource {
  id          String   @id @default(uuid())
  entityId    String
  accountId   String   // deposits arrive in this account
  description String   // e.g. "Eric payroll", "Eva paycheck"
  cadence     String   // semi_monthly | biweekly | monthly | weekly
  dayRules    Json     // semi_monthly: {"daysOfMonth":[15,30]}
                       // biweekly: {"intervalDays":14,"anchorDate":"2026-01-03"}
  amount      Decimal  @db.Decimal(14, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entity  Entity  @relation(fields: [entityId], references: [id])
  account Account @relation(fields: [accountId], references: [id])
}

// ─── Paystubs (personal income verification) ──────────────────────────────────
// Amounts in integer cents — never floats. Ground rules: no fabricated data;
// a null field means the stub didn't state it.

model Paystub {
  id                String    @id @default(uuid())
  entityId          String
  uploadedBy        String    // user id
  fileKey           String    // object storage key (encrypted at rest)
  capturedAt        DateTime
  // Where this paycheck is direct-deposited (defaults to Primary Checking)
  depositAccountId  String?
  extractStatus     String    @default("pending") // pending | complete | failed
  employeeName      String?
  employerName      String?
  payPeriodStart    DateTime?
  payPeriodEnd      DateTime?
  payDate           DateTime?
  // Pay frequency inferred at extraction; user confirms at review
  payFrequency      String?   // semi_monthly | biweekly | weekly | monthly
  grossPayCents     Int?
  pretaxDeductions  Json?     // [{ label: "401(k)", amountCents: 10000 }, ...]
  taxesCents        Int?      // sum of all tax withholdings
  taxBreakdown      Json?     // [{ label: "Federal", amountCents: 42000 }, ...]
  // Extra federal/state tax money elected on the W-4 beyond the stub's tax
  // lines — counted as tax PAID for refund/balance-due purposes.
  additionalWithholding Json? // [{ label: "Federal extra (W-4 4c)", amountCents: 5000 }, ...]
  netPayCents       Int?
  // Math verification: gross − pretax − taxes = net (0 = balanced)
  balanceDiffCents  Int?
  extractionRaw     Json?     // raw Claude extraction response
  confirmedAt       DateTime?
  confirmedById     String?
  notes             String?
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  entity  Entity   @relation(fields: [entityId], references: [id])
  account Account? @relation("PaystubDepositAccount", fields: [depositAccountId], references: [id])
}

// ─── Projected revenue (manual/forecast-only business income) ─────────────────
// NOT a booked transaction — tentative income for predictive purposes.
// Captured revenue comes from bank deposits (JCSB/QuickBooks) instead.

model ProjectedRevenue {
  id          String    @id @default(uuid())
  entityId    String
  accountId   String?   // account the revenue is expected to land in (optional)
  description String
  expectedDate DateTime
  amountCents Int       // cents — never float; positive amount
  source      String    @default("manual") // manual | other
  notes       String?
  realizedAt  DateTime? // set when matching deposit is observed (manual flag)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  entity  Entity   @relation(fields: [entityId], references: [id])
  account Account? @relation(fields: [accountId], references: [id])
}

// ─── Plaid items (one per institution login) ──────────────────────────────────

model PlaidItem {
  id                   String    @id @default(uuid())
  itemId               String    @unique // Plaid's item_id
  accessTokenEncrypted String            // AES-256-GCM encrypted access token
  institutionId        String?           // Plaid institution_id
  institutionName      String?
  status               String    @default("active") // active | requires_login | error
  lastSyncedAt         DateTime?
  cursorEncrypted      String?           // encrypted transactions/sync cursor
  consentExpiresAt     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  accounts Account[]
}

// ─── Mileage log (business deduction tracking) ───────────────────────────────

model MileageEntry {
  id          String    @id @default(uuid())
  entityId    String
  date        DateTime
  miles       Int                            // whole miles per trip
  purpose     String                         // "Client meeting — Hartford"
  billable    Boolean   @default(false)
  ratePerMile Decimal   @db.Decimal(5, 3) @default(0.700) // IRS rate at time of entry
  notes       String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  entity Entity @relation(fields: [entityId], references: [id])
}

// ─── Donation log (Schedule A line 11 data source) ───────────────────────────
// Tax-related records are NEVER hard-deleted; archivedAt only. Money is integer cents.
// The tax year is derived from `date` (like MileageEntry) - there is no separate taxYear column to drift.
model Donation {
  id                String    @id @default(uuid())
  entityId          String                       // always the Personal entity (enforced in the action)
  date              DateTime                     // stored as noon UTC of the gift date
  recipient         String                       // organization name
  amountCents       Int                          // cash amount, or the owner-stated fair market value for non-cash; > 0
  kind              String                       // cash | noncash   (app-validated, no DB enum)
  substantiation    String    @default("none")   // none | bank_record | written_acknowledgment  (owner-reported evidence type)
  receiptDocumentId String?                      // optional uploaded receipt / acknowledgement
  notes             String?
  archivedAt        DateTime?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  entity          Entity    @relation(fields: [entityId], references: [id])
  receiptDocument Document? @relation("DonationReceipt", fields: [receiptDocumentId], references: [id], onDelete: SetNull)
  createdBy       User?     @relation("DonationCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([entityId, date])
}

// ─── Fixed-asset register (Form 4562 / Schedule C line 13 / Schedule E line 18 INPUTS only) ──
// The app records what was entered. It never computes depreciation, picks a MACRS class,
// or decides Section 179 / bonus - that is the CPA's call.
model FixedAsset {
  id                  String    @id @default(uuid())
  entityId            String                      // a business entity (EK Consulting, Sudden Valley); Personal not supported in v1
  description         String
  placedInServiceDate DateTime                    // noon UTC of the date as entered
  costBasisCents      Int                         // > 0, as entered by the owner
  isRealProperty      Boolean   @default(false)   // true => landValueCents is required
  landValueCents      Int?                        // required (0 <= land <= cost) when isRealProperty, else null
  businessUsePercent  Int       @default(100)     // whole percent 1..100
  invoiceDocumentId   String?                     // optional purchase invoice / closing statement
  notes               String?
  archivedAt          DateTime?
  createdById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  entity          Entity    @relation(fields: [entityId], references: [id])
  invoiceDocument Document? @relation("FixedAssetInvoice", fields: [invoiceDocumentId], references: [id], onDelete: SetNull)
  createdBy       User?     @relation("FixedAssetCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([entityId, placedInServiceDate])
}

// ─── CPA-input questionnaires (Forms page "Needs CPA input" cards) ───────────
// Owner-reported FACTS for the CPA only; nothing here is a tax determination and it
// never changes a form's applicability or readiness. Never hard-deleted: "reset"
// just empties `answers`/`note` (the audit row keeps the prior answer values).
model TaxQuestionnaire {
  id                String    @id @default(uuid())
  taxYear           Int
  entityId          String    // Personal entity id for household questionnaires; the business entity id for entity-scoped ones
  questionnaireId   String    // registry id, e.g. "form-8889" (app-validated, no DB enum)
  definitionVersion Int       @default(1)
  answers           Json      @default("{}") // { [nodeId]: { v: string | string[] | number | null, at: ISO string, by: userId | null } }
  note              String?   // note for the CPA, <= 2000 chars, never written to AuditLog
  noteUpdatedAt     DateTime?
  noteUpdatedById   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  entity        Entity @relation(fields: [entityId], references: [id])
  noteUpdatedBy User?  @relation("TaxQuestionnaireNoteAuthor", fields: [noteUpdatedById], references: [id], onDelete: SetNull)

  @@unique([taxYear, entityId, questionnaireId])
}

// ─── TY2025 return overrides (CPA / owner pins layered over the computed return) ─
// Append-only: a change creates version + 1 and archives the previous active row
// ("superseded"); clearing only sets archivedAt ("cleared"). NO delete path (tax
// records are never hard-deleted). `reason` / `archiveReason` are tax records but
// are NEVER written to AuditLog. Active = archivedAt IS NULL.
model TaxReturnOverride {
  id               String    @id @default(uuid())
  taxYear          Int
  entityId         String    // Personal entity id (household return), same convention as TaxQuestionnaire
  targetKind       String    // "line" | "decision" | "rule_ack" (app-validated, no DB enum)
  targetKey        String    // LineKey | decision id (keyof Ty2025Decisions) | rule id
  version          Int       // 1, 2, 3 ... per (taxYear, entityId, targetKind, targetKey)
  valueKind        String    // "money_cents" | "choice" | "ack"
  valueCents       Int?      // line overrides: whole dollars expressed in cents
  valueText        String?   // decision choice id (<= 40 chars, validated against the typed registry)
  computedSnapshot Json      // { status, cents | null, engineVersion? } of the BASE line (rule status for acks) WHEN set; server-computed
  authority        String    @default("cpa") // "cpa" | "owner" (who instructed it)
  reason           String    // REQUIRED, 3..500 chars; never written to AuditLog
  setById          String?
  setByName        String    // display-name snapshot so who-set survives a SET NULL
  setAt            DateTime  @default(now())
  archivedAt       DateTime? // set when superseded or cleared; NULL = active
  archivedById     String?
  archiveKind      String?   // "superseded" | "cleared"
  archiveReason    String?   // required when cleared; <= 500; never audited
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  entity     Entity @relation(fields: [entityId], references: [id])
  setBy      User?  @relation("TaxReturnOverrideSetter", fields: [setById], references: [id], onDelete: SetNull)
  archivedBy User?  @relation("TaxReturnOverrideArchiver", fields: [archivedById], references: [id], onDelete: SetNull)

  @@unique([taxYear, entityId, targetKind, targetKey, version])
  @@index([taxYear, entityId, archivedAt])
}

// ─── Tax facts carry-forward store (tax-facts-carry-forward-store) ────────────
// Owner-confirmed facts for the household return, kept so the same questions need not be asked every year.
// APPEND-ONLY / versioned like TaxReturnOverride: a change, a re-confirmation for a new year, a policy change, a
// retirement and the resolution of an open item are each a NEW version; only `archivedAt` (set when superseded by the
// next version) is ever updated; there is no delete path (tax records are never hard-deleted). The latest version of a
// key is the row with archivedAt = NULL. NOT read by the TY2025 engine, the return fingerprint or the AI reviewer.
// `reason` is a tax record and is never written to AuditLog. No SSN, EIN, account number or date of birth is ever stored.
model TaxFact {
  id           String    @id @default(uuid())
  entityId     String    // Personal entity id (household return), same convention as TaxReturnOverride
  factKey      String    // stable dotted key, e.g. "decision.x1.home_office_method" (regex in lib/tax-facts/validate.ts)
  version      Int       // 1, 2, 3 ... per (entityId, factKey)
  category     String    // "household" | "income" | "business" | "retirement" | "payments" | "property" | "estate" | "decision" | "open_item" (app-validated, no DB enum)
  label        String    // owner-facing title, <= 120
  taxYear      Int       // the tax year THIS version was established / changed / reconfirmed FOR
  valueKind    String    // "text" | "choice" | "bool" | "percent" | "money_cents" | "none_statement" | "open_item"
  valueCents   Int?      // money_cents only (whole cents)
  valueText    String?   // every other kind (<= 600): choice id, "yes"/"no", percent "50" or "12.5", free text
  carryPolicy  String    // "stable" | "reconfirm" | "year_specific" | "derived"
  changeKind   String    // "established" | "changed" | "reconfirmed" | "policy_changed" | "retired" | "resolved"
  sourceKind   String    // "owner_statement" | "document" | "decision" | "derived"
  sourceRef    String?   // pointer only, no values (<= 200)
  reason       String?   // required for changed / retired / resolved (3..500); tax record, never written to AuditLog
  confirmedAt  DateTime  // when the owner confirmed it
  setById      String?
  setByName    String    // display-name snapshot so who-set survives a SET NULL
  setAt        DateTime  @default(now())
  archivedAt   DateTime? // set when SUPERSEDED by the next version; NULL = latest version
  archivedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  entity     Entity @relation(fields: [entityId], references: [id])
  setBy      User?  @relation("TaxFactSetter", fields: [setById], references: [id], onDelete: SetNull)
  archivedBy User?  @relation("TaxFactArchiver", fields: [archivedById], references: [id], onDelete: SetNull)

  @@unique([entityId, factKey, version])
  @@index([entityId, archivedAt])
}

// ─── TY2025 return review (AI Return Reviewer) and owner approval ─────────────
// ALL FOUR tables below are INSERT-ONLY: the app never updates or deletes a row (a source-reading test pins it;
// tax records are never hard-deleted). State is derived at read time: a finding is open / accepted / fixed from
// the dispositions and from later runs; "stale" is a fingerprint comparison; the verdict is computed by
// lib/tax-review/gate.ts. Nothing here ever stores an SSN, a bank number or a document's raw extraction: findings
// and reasons pass containsSsnLikeText before insert. `reason` / `typed*` values are tax records and are never
// written to AuditLog (ids, fingerprints and counts only).

// One execution of the deterministic checks (L1; L2 / L3 results are added in later phases) for one return state.
model TaxReviewRun {
  id             String   @id @default(uuid())
  taxYear        Int
  entityId       String   // Personal entity id (household return), same convention as TaxReturnOverride
  fingerprint    String   // 64 hex: return fingerprint v2 (lib/tax-review/fingerprint.ts) this run is bound to
  engineVersion  String
  startedById    String?
  startedByName  String   // display-name snapshot so who-started survives a SET NULL
  startedAt      DateTime @default(now())
  config         Json     // { fingerprintVersion, fingerprintParts (digests only), l1Version, l2Version, mode, ... }
  l1Summary      Json     // counts per severity / check, coverage lists; never values
  l2Summary      Json     // { status: "not_run" | ..., coverage: [] }
  createdAt      DateTime @default(now())

  entity    Entity             @relation(fields: [entityId], references: [id])
  startedBy User?              @relation("TaxReviewRunStarter", fields: [startedById], references: [id], onDelete: SetNull)
  findings  TaxReviewFinding[]
  approvals TaxReturnApproval[]

  @@index([taxYear, entityId, startedAt])
}

// One finding of one run. Immutable: closing a finding is a TaxReviewFindingDisposition row or a later run that no
// longer emits the same `key`.
model TaxReviewFinding {
  id                String   @id @default(uuid())
  runId             String
  key               String   // stable: sha256(layer|check|formKey|lineKey|ruleTag).slice(0,16)
  layer             String   // "L1" | "L2" | "L3"
  check             String   // e.g. "L1.F1.f1040.9"
  severity          String   // "blocker" | "high" | "medium" | "low" | "info"
  area              String   // "income" | "adjustments" | "deductions" | "credits" | "payments" | "tax" | "state" | "forms" | "process" | "packaging" | "privacy"
  formKey           String?
  lineKey           String?
  message           String
  evidence          Json     // [{ lineKey, amount, status }]
  citation          Json     // { sources: [...], sourceStatus }
  recommendedAction String
  acceptable        Boolean  // false = a broken invariant: fix the return, it cannot be accepted
  origin            String   // "deterministic" | "llm"
  pass              String?
  downgradedFrom    String?
  challenge         String?
  rejectedReason    String?
  evidenceHash      String   // sha256(canonical evidence).slice(0,16): an acceptance applies only while it is unchanged
  createdAt         DateTime @default(now())

  run TaxReviewRun @relation(fields: [runId], references: [id])

  @@index([runId])
  @@index([runId, key])
}

// "accepted" / "reopened" for a finding key + evidence hash, with the owner's written reason. The latest row for a
// (findingKey, evidenceHash) wins. There is NO waiver record: a review layer that has not run keeps the gate red.
model TaxReviewFindingDisposition {
  id           String   @id @default(uuid())
  taxYear      Int
  entityId     String
  findingKey   String
  evidenceHash String
  action       String   // "accepted" | "reopened"
  reason       String   // 3..500 chars, required for "accepted"; never written to AuditLog
  byId         String?
  byName       String
  at           DateTime @default(now())
  createdAt    DateTime @default(now())

  entity Entity @relation(fields: [entityId], references: [id])
  by     User?  @relation("TaxReviewDispositionAuthor", fields: [byId], references: [id], onDelete: SetNull)

  @@index([taxYear, entityId, findingKey])
}

// The owner's approval of a return state ("approved") or its withdrawal ("withdrawn"). "Current approval" = the latest
// row for (taxYear, entityId) that is "approved", is not followed by a "withdrawn", and whose fingerprint equals the
// CURRENT return fingerprint.
model TaxReturnApproval {
  id                    String   @id @default(uuid())
  taxYear               Int
  entityId              String
  kind                  String   // "approved" | "withdrawn"
  runId                 String
  fingerprint           String   // 64 hex
  verdictSnapshot       Json     // the gate result as computed server-side at that moment (counts, item states)
  attestationVersion    String?  // e.g. "v1" (approved rows)
  attestationTextHash   String?  // sha256 of the attestation text shown
  typedConfirmationHash String?  // sha256 of the typed phrase + name
  reason                String?  // withdrawn rows: 3..500 chars; never written to AuditLog
  approvedById          String?
  approvedByName        String
  at                    DateTime @default(now())
  createdAt             DateTime @default(now())

  entity     Entity       @relation(fields: [entityId], references: [id])
  run        TaxReviewRun @relation(fields: [runId], references: [id])
  approvedBy User?        @relation("TaxReturnApprovalApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([taxYear, entityId, at])
}

// One step of the AI review passes (L3) of a TaxReviewRun: run_started (config + estimate), payload (the exact redacted JSON that was
// sent), register, task_started / task_completed / task_failed per task, cancelled, stale. APPEND-ONLY, like the run row it belongs
// to (the run row is immutable): the state of an AI review is DERIVED from these events (lib/tax-review/llm/progress.ts). `eventKey`
// is unique per run, which makes every append idempotent and lets two tabs race for a task safely. No relation to TaxReviewRun on
// purpose (additive migration that touches no existing table). The L3 findings themselves are ordinary TaxReviewFinding rows of the
// same run (layer "L3"). Never stores a value outside the redacted payload.
model TaxReviewRunEvent {
  id        String   @id @default(uuid())
  runId     String
  eventKey  String   // "run_started" | "payload" | "register" | "start:<task>:<n>" | "done:<task>" | "fail:<task>:<n>" | "cancelled" | "stale"
  kind      String
  taskId    String?
  attempt   Int?
  data      Json
  createdAt DateTime @default(now())

  @@unique([runId, eventKey])
  @@index([runId, createdAt])
}

// ─── Tax deadlines (quarterly estimates + annual filings) ─────────────────────



// Tax-related records are NEVER hard-deleted; archivedAt only.
model TaxDeadline {
  id         String    @id @default(uuid())
  entityId   String
  label      String                         // "2025 Schedule C — extended"
  dueDate    DateTime
  type       String                         // quarterly_est | annual | extension | other
  status     String    @default("upcoming") // upcoming | filed | waived
  notes      String?
  archivedAt DateTime?                      // never hard-delete tax records
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  entity Entity @relation(fields: [entityId], references: [id])
}

// ─── Secure vault (financial credentials + contacts) ─────────────────────────

model VaultEntry {
  id            String   @id @default(uuid())
  name          String
  category      String   // "login" | "account" | "contact" | "card" | "other"
  institution   String?
  dataEncrypted String   // encrypt(JSON.stringify({ fields: [{key,value}] }))
  notes         String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model VaultOtp {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VaultSession {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Financial goals (advisor) ───────────────────────────────────────────────

model FinancialGoal {
  id                 String    @id @default(uuid())
  title              String
  description        String?
  category           String    // emergency_fund | debt_payoff | savings | investment | income | lifestyle | other
  targetAmountCents  Int?      // null = qualitative goal
  currentAmountCents Int?      // manually tracked progress
  targetDate         DateTime?
  priority           Int       @default(1) // 1=high, 2=medium, 3=low
  status             String    @default("active") // active | achieved | paused
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// ─── Debt tracking ────────────────────────────────────────────────────────────

model DebtDetail {
  id                   String   @id @default(cuid())
  accountId            String?  @unique        // null = standalone debt
  name                 String
  originalBalanceCents Int?                    // for progress bar
  manualBalanceCents   Int?                    // balance when no Plaid sync
  interestRate         Decimal? @db.Decimal(5, 3)
  monthlyPaymentCents  Int?
  paymentDay           Int?                    // day of month (1–31)
  tagId                String?
  notes                String?
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  tag     Tag?     @relation(fields: [tagId], references: [id], onDelete: SetNull)
}

// ─── App settings ─────────────────────────────────────────────────────────────

model AppSetting {
  key   String @id
  value String
}

// ─── Duplicate transaction actions (reversible log) ──────────────────────────
// Exact duplicates (date, amount, payee, account) are archived automatically.
// The KEPT transaction id is logged so an action can be undone (the duplicate
// is restored via undo, not the kept one). Undo un-archives and deletes the log.

model DedupAction {
  id                String   @id @default(uuid())
  duplicateTxId     String   @unique // the archived duplicate's transaction id
  keptTxId           String            // the surviving original
  accountId          String
  entityId           String
  postedAt           DateTime
  amount             Decimal  @db.Decimal(14, 2)
  payeeNormalized    String?
  reason             String   @default("exact_match") // exact_match | undo_reversal
  detectedBy         String   @default("cron")        // cron | manual
  undoneAt           DateTime?
  undoneById         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([createdAt])
  @@index([entityId])
}
